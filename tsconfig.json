{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "bot/**/*.ts", "scripts/**/*.ts", "build/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
