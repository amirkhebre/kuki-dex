# KUKI DEX + arbitrage bot
# Copy to .env and fill in. Never commit .env.

# --- chain -----------------------------------------------------------------
TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# TON_API_KEY=            # strongly recommended on mainnet (rate limits)

# --- tokens ----------------------------------------------------------------
KUKI_JETTON=EQCK1R0hqLuqG3XuG_CR_flKuZZuOxryCrAL3bH44Dq9RUa3

# --- pools -----------------------------------------------------------------
# The KUKI DEX pool (printed by `pnpm deploy`).
KUKI_POOL=
# The STON.fi pool for the same pair (e.g. KUKI/TON).
STONFI_POOL=EQCjsEs7maKN4R-f7Hbit7Ds7Ua5KBdUsaEKG7Dv6RyqTPGv
STONFI_ROUTER=EQCiypoBWNIEPlarBp04UePyEj5zH0ZDHxuRNqJ1WQx3FCY-
STONFI_ROUTER_VERSION=v2_1

# --- bot -------------------------------------------------------------------
# Leave unset for read-only monitoring.
# KUKI_WALLET_MNEMONIC=word1 word2 ... word24
EXECUTE=0
MIN_PROFIT_TON=0.25
# Start small while liquidity is thin.
MAX_TRADE_TON=5
GAS_PER_TRADE_TON=0.45
INTERVAL_MS=8000
SLIPPAGE_BPS=50
# Profit guard (protorev-style).
MIN_EDGE_BPS=40
MAX_POOL_SHARE_BPS=2000
COOLDOWN_MS=20000
MAX_FAILURES=3

# --- deployment (scripts/deploy.ts) ---------------------------------------
TOKEN_JETTON=
TON_SIDE=1
ADMIN_ADDRESS=
PROTOCOL_FEE_BPS=10
WEIGHTS=1,1
FEE_BPS=30
DRY_RUN=1

# --- seeding (scripts/seed.ts) --------------------------------------------
KUKI_AMOUNT=
TOKEN_AMOUNT=
BENEFICIARY=

# --- web / telegram mini app ----------------------------------------------
# Never put the bot token in web/ — it is server-side only.
DEX_BOT_TOKEN=
DEX_URL=https://kuki-dex.kukitap.workers.dev
